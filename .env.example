# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App (Required)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: OpenAI (for WhatsApp AI bot)
OPENAI_API_KEY=your_openai_api_key

# Optional: WhatsApp Service
NEXT_PUBLIC_WHATSAPP_SERVICE_URL=http://localhost:3002

# Required: WhatsApp Service API key (sent as `x-api-key` header on every call to the Baileys service)
# NEXT_PUBLIC_* so it is available in the browser (used by the WhatsApp dashboard page)
NEXT_PUBLIC_WHATSAPP_API_KEY=your_whatsapp_service_api_key

# Required: WhatsApp inbound webhook secret (shared with Baileys service)
# The Baileys service must send it as `x-webhook-secret` or `Authorization: Bearer <secret>`
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# Required: CRON secret (sent as `Authorization: Bearer <secret>` from Vercel cron jobs)
CRON_SECRET=your_cron_secret

# Optional: Admin API (for entitlements)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# Google Drive Storage (Optional — enables cloud storage for patient files)
# Get these from Google Cloud Console: https://console.cloud.google.com
# 1. Create a Service Account in your project
# 2. Download the JSON credentials
# 3. Share your Google Drive folder with the service account email
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here
